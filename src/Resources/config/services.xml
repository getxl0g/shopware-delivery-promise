<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <!-- Service: encapsulates config + the HTTP call to the xl0g promise API (X-API-Key, server-side).
             cache.object = Shopware's object cache (Redis) for the positive/negative cache of the promise data. -->
        <service id="Xl0g\DeliveryPromise\Service\Xl0gPromiseClient">
            <argument key="$cache" type="service" id="cache.object"/>
            <tag name="monolog.logger" channel="xl0g_delivery_promise"/>
        </service>

        <!-- Additional transit time per delivery country (config mapping, sales-channel scoped). -->
        <service id="Xl0g\DeliveryPromise\Service\CountryTransitProvider">
            <tag name="monolog.logger" channel="xl0g_delivery_promise"/>
        </service>

        <!-- Resolves the xl0g shipping method: product custom field (UUID ⇒ xl0g mapping of the
             referenced shipping method) or, in the checkout, the custom field mapping of the selected
             shipping method, otherwise the configured default. -->
        <service id="Xl0g\DeliveryPromise\Service\ShippingMethodResolver">
            <argument key="$shippingMethodRepository" type="service" id="shipping_method.repository"/>
            <tag name="monolog.logger" channel="xl0g_delivery_promise"/>
        </service>

        <!-- Service: builds the Schema.org JSON-LD (pure functions, unit-testable). -->
        <service id="Xl0g\DeliveryPromise\Service\StructuredDataBuilder"/>

        <!-- Collects per request the cutoffs of the rendered dates (Twig widgets + JSON-LD);
             basis for capping the page's s-maxage. -->
        <service id="Xl0g\DeliveryPromise\Service\RenderedPromiseCollector"/>

        <!-- Caps the page's s-maxage (product page in the HTTP cache) at the cutoff of the rendered
             date — only shortening, only if Shopware made the response cacheable.
             autoconfigure tags EventSubscriberInterface automatically. -->
        <service id="Xl0g\DeliveryPromise\Storefront\Subscriber\HttpCacheCutoffSubscriber"/>

        <!-- Twig functions for the server-side first render (autoconfigure tags twig.extension). -->
        <service id="Xl0g\DeliveryPromise\Twig\DeliveryPromiseTwigExtension"/>

        <!-- Twig function xl0g_inject_shipping_details() — merges the shippingDetails into the
             product JSON-LD of the Shopware core (feature flag JSON_LD_DATA). -->
        <service id="Xl0g\DeliveryPromise\Twig\StructuredDataTwigExtension"/>

        <!-- Classifies the visitor of a product page in the shop (browser, AI agent, search engine, tool) for the page
             view report; the user agent never leaves the shop. -->
        <service id="Xl0g\DeliveryPromise\Service\VisitorClassifier"/>

        <!-- Service: builds the agent discovery manifest + llms.txt (pure functions, unit-testable). -->
        <service id="Xl0g\DeliveryPromise\Service\AgentDiscoveryBuilder"/>

        <!-- Subscriber that enriches the product page with shippingDetails JSON-LD.
             autoconfigure tags EventSubscriberInterface automatically. -->
        <service id="Xl0g\DeliveryPromise\Storefront\Subscriber\StructuredDataSubscriber"/>

        <!-- Storefront proxy controller (thin; uses the client). setContainer for StorefrontController. -->
        <service id="Xl0g\DeliveryPromise\Storefront\Controller\DeliveryPromiseController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- The shop's MCP server (POST /mcp, answered by xl0g for the tenant): config, forwarding with the shop-side key,
             filter to the public tools, per-address limit in the object cache. -->
        <service id="Xl0g\DeliveryPromise\Service\ShopMcpProxy">
            <argument key="$cache" type="service" id="cache.object"/>
            <tag name="monolog.logger" channel="xl0g_delivery_promise"/>
        </service>

        <!-- MCP controller (POST /mcp + /.well-known/mcp/server-card.json). -->
        <service id="Xl0g\DeliveryPromise\Storefront\Controller\McpController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <!-- Discovery controller (llms.txt + /.well-known/xl0g-delivery.json). -->
        <service id="Xl0g\DeliveryPromise\Storefront\Controller\DiscoveryController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
