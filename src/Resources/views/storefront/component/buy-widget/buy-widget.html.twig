{% sw_extends '@Storefront/storefront/component/buy-widget/buy-widget.html.twig' %}

{# xl0g Delivery Promise — widget placeholder + JSON-LD in the buy box, right after Shopware's own delivery information.
   Since Shopware 6.5 the buy box is the component buy-widget (also inside the CMS buy-box element); the block
   page_product_detail_buy_container of page/product-detail/index.html.twig is no longer rendered there, so the plugin
   hooks into buy_widget_delivery_informations (present in 6.6 and 6.7).
   • Widget: filled by JS, stays hidden if xl0g delivers nothing (no broken widget).
   • JSON-LD: Schema.org Product/Offer/shippingDetails (the subscriber provides the page extension).
   Text = Shopware snippets (per sales channel); the NUMBERS come from xl0g /api/promise?format=data. #}
{% block buy_widget_delivery_informations %}
    {{ parent() }}

    {% if page is defined and page.extensions.xl0gShippingDetails is defined and page.extensions.xl0gShippingDetails %}
        <script type="application/ld+json">{{ page.extensions.xl0gShippingDetails.get('jsonLd')|raw }}</script>
    {% endif %}

    <div class="xl0g-delivery-promise"
         hidden
         data-xl0g-delivery-promise
         data-endpoint="{{ path('frontend.xl0g.delivery_promise') }}"
         data-shipping-method="standard"
         data-context="pdp"
         data-sku="{{ product.productNumber }}"
         data-template="{{ 'xl0g.deliveryPromise.line'|trans|e('html_attr') }}"
         data-unit-hours="{{ 'xl0g.deliveryPromise.unitHours'|trans|e('html_attr') }}"
         data-unit-minutes="{{ 'xl0g.deliveryPromise.unitMinutes'|trans|e('html_attr') }}"
         aria-live="polite">
    </div>
{% endblock %}
