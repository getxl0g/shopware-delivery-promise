{% sw_extends '@Storefront/storefront/page/checkout/confirm/index.html.twig' %}

{# xl0g Delivery Promise in checkout — only if enabled in the plugin (enableCheckoutWidget).
   Same JS plugin as on the PDP (selector [data-xl0g-delivery-promise]); context "checkout".
   TODO(test 6.7): verify the block name against the real confirm template. #}
{% block page_checkout_confirm_tos %}
    {% if config('Xl0gDeliveryPromise.config.enableCheckoutWidget') %}
        <div class="xl0g-delivery-promise xl0g-delivery-promise--checkout"
             hidden
             data-xl0g-delivery-promise
             data-endpoint="{{ path('frontend.xl0g.delivery_promise') }}"
             data-shipping-method="{{ config('Xl0gDeliveryPromise.config.defaultShippingMethod')|default('standard') }}"
             data-context="checkout"
             data-template="{{ 'xl0g.deliveryPromise.line'|trans|e('html_attr') }}"
             data-unit-hours="{{ 'xl0g.deliveryPromise.unitHours'|trans|e('html_attr') }}"
             data-unit-minutes="{{ 'xl0g.deliveryPromise.unitMinutes'|trans|e('html_attr') }}"
             aria-live="polite">
        </div>
    {% endif %}

    {{ parent() }}
{% endblock %}
